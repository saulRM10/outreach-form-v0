# === Google service account credentials ===
# From the JSON key file you download in Google Cloud Console.
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the ENTIRE private key including the BEGIN/END lines.
# Keep the literal \n characters — the app converts them at runtime.
# On Vercel, paste it wrapped in double quotes exactly as it appears in the JSON.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# === Target spreadsheet ===
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
